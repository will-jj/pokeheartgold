{
    "build": {
        "dockerfile": "Dockerfile",
        "options": [
            "--platform=linux/amd64"
        ]
    },
    "postCreateCommand": "make setup_rom",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python",
                "mesonbuild.mesonbuild"
            ],
            "settings": {
                "C_Cpp.clang_format_path": "/usr/local/bin/clang-format",
                "mesonbuild.mesonPath": "${containerWorkspaceFolder}/subprojects/meson-1.12.0/meson.py",
                "mesonbuild.buildFolder": "build/heartgold.us"
            }
        }
    }
}
