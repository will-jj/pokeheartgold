{
    "build": {
        "dockerfile": "Dockerfile",
        "options": [
            "--platform=linux/amd64"
        ]
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "ms-python.python"
            ],
            "settings": {
                "C_Cpp.clang_format_path": "/usr/local/bin/clang-format"
            }
        }
    }
}